# Copy this file to .env.local and fill in your own values.

# MySQL/MariaDB connection string
DATABASE_URL="mysql://root:@localhost:3306/cotoom"

# NextAuth — generate a strong secret, e.g.: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""

# Mapbox (optional)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# Pusher (https://dashboard.pusher.com)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"
